# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force scripts and documentation to LF
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Windows specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git LFS for binary ONNX models
*.onnx filter=lfs diff=lfs merge=lfs -text
