# ==============================================================================
# Student Attendance Management System - Backend Configuration (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Flask Environment (development / production)
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-string
PORT=5000
HOST=0.0.0.0

# Firebase Configuration
# Set to 'false' in production with real Firebase service account credentials.
# Set to 'true' for local development/testing without live Firebase credentials.
MOCK_FIREBASE=false
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Face Recognition Calibration
# SFace cosine similarity threshold: values >= threshold are considered candidates (default: 0.380)
FACE_SIMILARITY_THRESHOLD=0.380
# Minimum difference required between top-1 and top-2 candidates to avoid ambiguity (default: 0.080)
FACE_MATCH_MARGIN=0.080
# Minimum face bounding box size in pixels (w and h)
FACE_MIN_SIZE=60
# Minimum face detection confidence from YuNet (0.0 to 1.0)
FACE_DETECTION_CONFIDENCE=0.80
# Minimum Laplacian variance for blur/sharpness check
FACE_MIN_BLUR_SCORE=50.0

# Directory containing YuNet and SFace ONNX models
FACE_MODEL_DIR=models

# Timezone for attendance timestamping (standard IANA timezone)
ATTENDANCE_TIMEZONE=Asia/Kolkata
