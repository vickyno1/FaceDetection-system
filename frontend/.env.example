# ==============================================================================
# Student Attendance Management System - Frontend Environment Variables (.env.example)
# Copy this file to .env and replace placeholders with your Firebase project keys.
# ==============================================================================

# API Base URL (empty string or /api uses the Vite proxy)
VITE_API_BASE_URL=/api

# Firebase Web App SDK Configuration
# Found in Firebase Console -> Project Settings -> General -> Your Apps -> Web App
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyPlaceholder
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Demo Mode toggle: When true, provides an instant One-Click Admin Demo login
VITE_ENABLE_DEMO_LOGIN=true
